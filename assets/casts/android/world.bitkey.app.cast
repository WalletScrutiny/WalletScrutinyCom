[807.09526, "o", "\r\u001b[52d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[52;18H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out     \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is\u001b[52G\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[52;69H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute\u001b[86G\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location\u001b[103G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[52;120H\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark     \u001b(B\u001b[0;7mM-]\u001b(B\u001b[m To Bracket   \u001b(B\u001b[0;7mM-Q\u001b(B\u001b[m Previous     \u001b(B\u001b[0;7m^B\u001b(B\u001b[m Back\u001b[52;188H\u001b(B\u001b[0;7m^◂\u001b(B\u001b[m Prev Word\r\u001b[53d"]
[807.095388, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[53;18H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File     \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[52G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[53;69H\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[86G\u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line    \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[53;120H\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy\u001b[53;137H\u001b(B\u001b[0;7m^Q\u001b(B\u001b[m Where Was     \u001b(B\u001b[0;7mM-W\u001b(B\u001b[m Next\u001b[53;171H\u001b(B\u001b[0;7m^F\u001b(B\u001b[m Forward\u001b[188G\u001b(B\u001b[0;7m^▸\u001b(B\u001b[m Next Word"]
[807.096027, "o", "\r\u001b[2dFROM ubuntu:jammy-20231211.1 as base\r\u001b[4dENV ANDROID_BUILD_TOOLS_VERSION=\"34.0.0\"\r\u001b[5dENV ANDROID_NDK_VERSION=\"25.2.9519653\"\r\u001b[7dRUN apt update\r\u001b[9dRUN apt install -y git=1:2.34.1-1ubuntu1.12\r\u001b[10d"]
[807.096287, "o", "RUN apt install -y build-essential=12.9ubuntu3\r\u001b[11dRUN apt install -y libclang1=1:14.0-55~exp2\r\u001b[12dRUN apt install -y openjdk-17-jdk=17.0.14+7-1~22.04.1\r\u001b[13dRUN apt install -y curl=7.81.0-1ubuntu1.20\r\u001b[14dRUN apt install -y sdkmanager=0.5.1-1\r\u001b[16dENV ANDROID_HOME=/opt/android-sdk\r\u001b[17d"]
[807.096426, "o", "ENV ANDROID_NDK_ROOT=$ANDROID_HOME/ndk/$ANDROID_NDK_VERSION\r\u001b[18dENV PATH=$ANDROID_HOME/tools:$PATH\r\u001b[19dENV PATH=$ANDROID_HOME/platform-tools:$PATH\r\u001b[21dENV REPRODUCIBLE_BUILD_TEST=$REPRODUCIBLE_BUILD_TEST\r\u001b[23dRUN sdkmanager \"platform-tools\" \"build-tools;$ANDROID_BUILD_TOOLS_VERSION\"\r\u001b[24dRUN sdkmanager --install \"ndk;$ANDROID_NDK_VERSION\"\r\u001b[26d\u001b[36m# Disables build scan plugin\r\u001b[27d\u001b[39m\u001b(B\u001b[mENV CI=true\r\u001b[29dCOPY . /build\r\u001b[31dWORKDIR /build\r\u001b[33dRUN ./app/verifiable-build/android/common/accept-sdk-license\r\u001b[35d\u001b[36m# Disable unnecessary download of Kotlin native compiler\r\u001b[36d\u001b[39m\u001b(B\u001b[mRUN printf \"\\nkotlin.native.toolchain.enabled=false\\n\" >> app/gradle.properties\r\u001b[38dENTRYPOINT [\"/bin/bash\", \"-c\"]\r\u001b[40dFROM base as build\r\u001b[42dARG REPRODUCIBLE_BUILD_VARIABLES\r\u001b[44dRUN echo \"$REPRODUCIBLE_BUILD_VARIABLES\" > /build/reproducible-build-variables.json\r\u001b[46dENV REPRODUCIBLE_BUILD=/build/reproducible-build-variables.json\r\u001b[2d"]
