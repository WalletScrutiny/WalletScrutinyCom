[10413.584193, "o", "Normalizing content of locally built APKs:\r\n\r\n"]
[10413.739399, "o", "\r\n\r\n---------------------------\r\n\r\nComparing builds:\r\n\r\n"]
[10413.747219, "o", "+ '[' 2 -ne 2 ']'\r\n+ which diff\r\n"]
[10413.748882, "o", "+ which /home/dannybuntu/Android/Sdk/build-tools/34.0.0/aapt2\r\n"]
[10413.758471, "o", "+ lhs_comparable=verify-apk/from-device/comparable\r\n"]
[10413.758609, "o", "+ lhs_apks=verify-apk/from-device/normalized-names\r\n+ rhs_comparable=verify-apk/locally-built/comparable\r\n+ rhs_apks=verify-apk/locally-built/normalized-names\r\n"]
[10413.758906, "o", "++ find verify-apk/from-device/normalized-names -maxdepth 1 -mindepth 1 -type f -exec basename '{}' ';'\r\n"]
[10413.765713, "o", "+ lhs_apk_files='base.apk\r\nen.apk\r\nxxhdpi.apk\r\narm64_v8a.apk'\r\n"]
[10413.76615, "o", "++ find verify-apk/locally-built/normalized-names -maxdepth 1 -mindepth 1 -type f -exec basename '{}' ';'\r\n"]
[10413.771503, "o", "+ rhs_apk_files='base.apk\r\nen.apk\r\nxxhdpi.apk\r\narm64_v8a.apk'\r\n"]
[10413.772218, "o", "+++ echo 'base.apk\r\nen.apk\r\nxxhdpi.apk\r\narm64_v8a.apk'\r\n++ sort -u /dev/fd/63 /dev/fd/62\r\n"]
[10413.772646, "o", "+++ echo 'base.apk\r\nen.apk\r\nxxhdpi.apk\r\narm64_v8a.apk'\r\n"]
[10413.776341, "o", "+ all_apk_files='arm64_v8a.apk\r\nbase.apk\r\nen.apk\r\nxxhdpi.apk'\r\n"]
[10413.776714, "o", "++ diff -x resources.arsc -r verify-apk/from-device/comparable verify-apk/locally-built/comparable\r\n"]
[10414.922935, "o", "+ differences='Binary files verify-apk/from-device/comparable/base/classes2.dex and verify-apk/locally-built/comparable/base/classes2.dex differ\r\nBinary files verify-apk/from-device/comparable/base/classes.dex and verify-apk/locally-built/comparable/base/classes.dex differ'\r\n+ diff_exit_status=1\r\n+ diff_result=1\r\n"]
[10414.92301, "o", "+ declare -a aapt_differences\r\n"]
[10414.923222, "o", "+ for apk_file in $all_apk_files\r\n+ '[' '!' -f verify-apk/from-device/normalized-names/arm64_v8a.apk ']'\r\n+ '[' '!' -f verify-apk/locally-built/normalized-names/arm64_v8a.apk ']'\r\n+ unzip -l verify-apk/from-device/normalized-names/arm64_v8a.apk resources.arsc\r\n"]
[10414.925736, "o", "Archive:  verify-apk/from-device/normalized-names/arm64_v8a.apk\r\n"]
[10414.926166, "o", "  Length      Date    Time    Name\r\n---------  ---------- -----   ----\r\n"]
[10414.938833, "o", "---------                     -------\r\n        0                     0 files\r\n"]
[10414.939663, "o", "+ lhs_contains_resources_exit_code=11\r\n+ unzip -l verify-apk/locally-built/normalized-names/arm64_v8a.apk resources.arsc\r\n"]
[10414.944603, "o", "Archive:  verify-apk/locally-built/normalized-names/arm64_v8a.apk\r\n  Length      Date    Time    Name\r\n---------  ---------- -----   ----\r\n---------                     -------\r\n        0                     0 files\r\n"]
[10414.945488, "o", "+ rhs_contains_resources_exit_code=11\r\n+ '[' 11 -ne 0 ']'\r\n+ '[' 11 -eq 0 ']'\r\n+ '[' 11 -eq 0 ']'\r\n"]
[10414.945627, "o", "+ echo 'Skipping aapt2 diff of arm64_v8a.apk as it doesn'\\''t contain resources.arsc file'\r\nSkipping aapt2 diff of arm64_v8a.apk as it doesn't contain resources.arsc file\r\n+ for apk_file in $all_apk_files\r\n+ '[' '!' -f verify-apk/from-device/normalized-names/base.apk ']'\r\n"]
