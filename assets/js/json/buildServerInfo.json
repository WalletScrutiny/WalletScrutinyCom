---
layout: compress
---
{
  "hardware": {
    {% for post in site.hardware %}
    "{{ post.appId }}": {
      "targets": {{ post.targets | jsonify }},
      "types": {{ post.types | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  },
  "desktop": {
    {% for post in site.desktop %}
    "{{ post.appId }}": {
      "targets": {{ post.targets | jsonify }},
      "types": {{ post.types | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  },
  "android": {
    {% for post in site.android %}
    "{{ post.appId }}": {
      "targets": {{ post.targets | jsonify }},
      "types": {{ post.types | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  }
}
