{
  "verdicts": {{ site.data.verdicts | jsonify }},
  "featureAlerts": {
    {% for f in site.data.features %}{% if f[1].alert %}"{{ f[0] }}": {{ f[1].short | jsonify }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}
  },
  "featureAlertMessages": {
    {% for f in site.data.features %}{% if f[1].alert %}"{{ f[0] }}": {{ f[1].alert | strip_html | strip_newlines | strip | jsonify }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}
  },
  "mobile": {
    "category": "Mobile",
    "apps": [
      {% assign mobile_posts = site.mobile | where: 'meta', 'ok' | where: 'verdict', 'sourceavailable' %}
      {% for post in mobile_posts %}
      {% include wallet_score.html verdict=post.verdict platform='mobile' %}
      {% assign mobile_slug = post.path | replace: '_mobile/', '' | replace: '.md', '' %}
      {% assign mobile_icon_folder = 'android' %}
      {% if post.android.icon %}{% assign mobile_icon_folder = 'android' %}{% elsif post.iphone.icon %}{% assign mobile_icon_folder = 'iphone' %}{% endif %}
      {
        "wsId": "{{ post.wsId }}",
        "appId": "{{ mobile_slug }}",
        "storeAppId": "{{ post.android.appId | default: post.iphone.appId }}",
        "storePlatform": "{% if post.android.appId %}android{% else %}iphone{% endif %}",
        "iconFolder": "{{ mobile_icon_folder }}",
        "title": "{{ post.title | escape }}",
        "altTitle": "{{ post.android.altTitle | default: post.iphone.altTitle }}",
        "icon": "{{ post.android.icon | default: post.iphone.icon }}",
        "meta": "{{ post.meta }}",
        "verdict": "{{ post.verdict }}",
        "url": "{{ post.url }}",
        "score": {numerator:{{ count }}, denominator:{{ criteria.size }}},
        "features": [{% for feat in post.features %}{% if site.data.features[feat] %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],
        "alertFeatures": [{% for feat in post.features %}{% if site.data.features[feat].alert %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}]
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  "hardware": {
    "category": "Hardware Wallet",
    "apps": [ 
      {% assign hardware = site.hardware | where: 'meta', 'ok' | where: 'verdict', 'sourceavailable' %}
      {% for post in hardware %}
      {% include wallet_score.html verdict=post.verdict platform='hardware' %}
      {
        "appId": "{{ post.appId }}",
        "title": "{{ post.title }}",
        "icon": "{{ post.icon }}",
        "meta": "{{ post.meta }}",
        "verdict": "{{ post.verdict }}",
        "url": "{{ post.url }}",
        "score": {numerator:{{ count }}, denominator:{{ criteria.size }}},
        "features": [{% for feat in post.features %}{% if site.data.features[feat] %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],
        "alertFeatures": [{% for feat in post.features %}{% if site.data.features[feat].alert %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}]
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  "bearer": {
    "category": "Bearer Token",
    "apps": [ 
      {% assign bearer = site.bearer | where: 'meta', 'ok' | where: 'verdict', 'sourceavailable' %}
      {% for post in bearer %}
      {% include wallet_score.html verdict=post.verdict platform='bearer' %}
      {
        "appId": "{{ post.appId }}",
        "title": "{{ post.title }}",
        "icon": "{{ post.icon }}",
        "meta": "{{ post.meta }}",
        "verdict": "{{ post.verdict }}",
        "url": "{{ post.url }}",
        "score": {numerator:{{ count }}, denominator:{{ criteria.size }}},
        "features": [{% for feat in post.features %}{% if site.data.features[feat] %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],
        "alertFeatures": [{% for feat in post.features %}{% if site.data.features[feat].alert %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}]
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  "desktop": {
    "category": "Desktop",
    "apps": [ 
      {% assign desktop = site.desktop | where: 'meta', 'ok' | where: 'verdict', 'sourceavailable' %}
      {% for post in desktop %}
      {% include wallet_score.html verdict=post.verdict platform='desktop' %}
      {
        "appId": "{{ post.appId }}",
        "title": "{{ post.title | escape }}",
        "icon": "{{ post.icon }}",
        "meta": "{{ post.meta }}",
        "verdict": "{{ post.verdict }}",
        "url": "{{ post.url }}",
        "score": {numerator:{{ count }}, denominator:{{ criteria.size }}},
        "features": [{% for feat in post.features %}{% if site.data.features[feat] %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],
        "alertFeatures": [{% for feat in post.features %}{% if site.data.features[feat].alert %}"{{ feat }}"{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}]
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  "others": {
    "category": "Others",
    "apps": [ 
      {% assign others = site.others | where: 'meta', 'ok' | where: 'verdict', 'sourceavailable' %}
      {% for post in others %}
      {
        "appId": "{{ post.appId }}",
        "title": "{{ post.title | escape }}",
        "icon": "{{ post.icon }}",
        "url": "{{ post.url }}"
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
}
