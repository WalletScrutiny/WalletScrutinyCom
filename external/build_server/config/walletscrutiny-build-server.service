[Unit]
Description=WalletScrutiny Build Server service
Documentation=file:/opt/build-server/walletScrutinyCom/external/build_server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=build-server
Group=build-server
WorkingDirectory=/opt/build-server/walletScrutinyCom/external/build_server

LoadCredentialEncrypted=build-server-ws-bot-pk:/etc/credstore.encrypted/build-server-ws-bot-pk
LoadCredentialEncrypted=build-server-gh-token:/etc/credstore.encrypted/build-server-gh-token

Environment=WS_BOT_PK_FILE=%d/build-server-ws-bot-pk
Environment=GITHUB_TOKEN_FILE=%d/build-server-gh-token

ExecStart=/usr/bin/node index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target