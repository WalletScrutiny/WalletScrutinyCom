{
  "name": "walletscrutiny-build-server",
  "version": "1.0.0",
  "description": "Application to get verification scripts from Nostr and run them automatically when a new version of a wallet is released",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "test": "BUILD_SERVER_TEST=1 BUILD_SERVER_DB_PATH=:memory: node --test --test-reporter=spec \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@nostr-dev-kit/ndk": "^2.18.1",
    "better-sqlite3": "^12.10.0",
    "isomorphic-dompurify": "^3.15.0",
    "js-yaml": "^4.1.1",
    "minimist": "^1.2.8",
    "p-queue": "^9.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0",
    "yauzl": "^3.3.1"
  },
  "engines": {
    "node": ">= 18.6.0"
  }
}
