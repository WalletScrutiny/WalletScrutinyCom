{
  "name": "walletscrutiny-ws-notifications",
  "version": "1.0.0",
  "description": "Publishes Nostr kind=1 notifications when new WalletScrutiny verifications are published",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "test": "WS_NOTIFICATIONS_TEST=1 WS_NOTIFICATIONS_DB_PATH=:memory: node --test --test-reporter=spec \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "minimist": "^1.2.8",
    "nostr-tools": "2.23.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">= 18.6.0"
  }
}
