[Unit]
Description=WalletScrutiny verification Nostr notifications (oneshot)
Documentation=file:/opt/ws-notifications/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=build-server
Group=build-server
WorkingDirectory=/opt/ws-notifications
StateDirectory=walletscrutiny-ws-notifications
LogsDirectory=ws-notifications

LoadCredentialEncrypted=build-server-ws-bot-pk:/etc/credstore.encrypted/build-server-ws-bot-pk

Environment=WS_BOT_PK_FILE=%d/build-server-ws-bot-pk
Environment=WS_NOTIFICATIONS_DB_PATH=/var/lib/walletscrutiny-ws-notifications/notifications.db
Environment=WS_NOTIFICATIONS_LOG_DIR=/var/log/ws-notifications
Environment=WS_NOTIFICATIONS_PUBLISH_DELAY_MS=3000

ExecStart=/usr/bin/node index.mjs

[Install]
WantedBy=multi-user.target
