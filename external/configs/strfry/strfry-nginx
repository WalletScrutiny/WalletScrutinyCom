server {
    listen 80;
    server_name relay.nostr.info;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name relay.nostr.info;

    ssl_certificate /etc/letsencrypt/live/relay.nostr.info/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/relay.nostr.info/privkey.pem; # managed by Certbot

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:7777;
        proxy_http_version 1.1;

        # WebSocket headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Timeout for long WebSocket connections
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 3600s;
    }
}
