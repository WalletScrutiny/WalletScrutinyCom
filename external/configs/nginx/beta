server {
    server_name beta.walletscrutiny.com;
    root /home/leo/wsg_beta/www;
    index index.html;
    listen 443 ssl;
    http2 on;
    server_tokens off;
    brotli_static on;

    access_log /var/log/nginx/access_walletscrutiny_beta.log;

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    ssl_certificate /etc/letsencrypt/live/beta.walletscrutiny.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/beta.walletscrutiny.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    add_header Permissions-Policy "interest-cohort=()";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload;";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src *; font-src 'self'; connect-src *; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' 'https://pos.btcpay.nz';" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

server {
    server_name beta.walletscrutiny.com;
    listen 80;
    return 301 https://$host$request_uri;
}
