[Unit]
Description=WalletScrutiny source analysis: release assets and source checks of the tracked wallets (oneshot)
Documentation=file:/opt/source_analysis/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=build-server
Group=build-server
WorkingDirectory=/opt/source_analysis
StateDirectory=walletscrutiny-source-analysis
CacheDirectory=walletscrutiny-source-analysis

# Same GitHub token as the build server (see README to use a separate one)
LoadCredentialEncrypted=build-server-gh-token:/etc/credstore.encrypted/build-server-gh-token

Environment=GITHUB_TOKEN_FILE=%d/build-server-gh-token
Environment=SOURCE_ANALYSIS_DB_PATH=/var/lib/walletscrutiny-source-analysis/assets.db
# Per-repository scratch (clone, node_modules, result), deleted after each repository
Environment=SOURCE_ANALYSIS_TEMP_DIR=/var/cache/walletscrutiny-source-analysis/repos
# npm/yarn/gradle/pip caches shared by the analysis containers, wiped past the cap
Environment=SOURCE_ANALYSIS_CACHE_DIR=/var/cache/walletscrutiny-source-analysis/cache
Environment=SOURCE_ANALYSIS_CACHE_MAX_GB=20
# The analysed repositories are untrusted: clone, install and checks run in a
# throwaway container (containerRunner.mjs: no token, no database, no docker
# socket, capabilities dropped, read-only root, memory/cpu/pid limits, timeout;
# npm lifecycle scripts disabled and no credential prompts inside). The process
# here only drives docker. Image, limits and timeout: config.mjs, overridable with
# SOURCE_ANALYSIS_IMAGE, SOURCE_ANALYSIS_CONTAINER_MEMORY, SOURCE_ANALYSIS_CONTAINER_CPUS,
# SOURCE_ANALYSIS_CONTAINER_TIMEOUT_MIN.
Environment=SOURCE_ANALYSIS_CONTAINER_CLI=docker
# Repositories analysed at the same time, each with the container limits above
Environment=SOURCE_ANALYSIS_CONCURRENCY=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

ExecStart=/usr/bin/node index.mjs

[Install]
WantedBy=multi-user.target
