  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "app-store-scraper": "^0.18.0",
    "async-mutex": "^0.3.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.8",
    "babel-loader": "^10.0.0",
    "canvas": "^2.11.2",
    "clean-css-cli": "^5.6.3",
    "dateformat": "^3.0.3",
    "file-type": "^16.5.4",
    "github-graphql-api": "^1.0.6",
    "google-play-scraper": "github:facundoolano/google-play-scraper#0280abf149b50682ca8f65c080302dc6d477c80b",
    "html-webpack-plugin": "^5.6.4",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "p-limit": "^4.0.0",
    "readline": "^1.3.0",
    "webpack": "^5.102.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-shell-plugin-next": "^2.3.3"
  },
  "scripts": {
    "dev": "npm run clean_assets && webpack --mode development --watch",
    "build": "npm run clean_assets && webpack --mode production --no-watch && npm run compress",
    "clean_assets": "jekyll clean && rm -rf dist/*",
    "compress": "npm run minifyJs && npm run minifyCss && npm run brotlifyHtml && npm run brotlifyOthers",
    "minifyJs": "npx foreach-cli -g \"_site/**/*.js\" -i \"_site/**/*.min.js\" -x \"terser #{path} -o #{path}\"",
    "minifyCss": "npx foreach-cli -g \"_site/**/*.css\" -i \"_site/**/*.min.css\" -x \"cleancss -o #{path} #{path}\"",
    "brotlifyHtml": "npx brotli-cli compress -q 6 --glob \"_site/**/*.html\"",
    "brotlifyOthers": "npx brotli-cli compress -q 10 --glob \"_site/*.html\" --glob \"_site/**/*.{js,css,json,ttf,svg,eot,cast}\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@napi-rs/canvas": "^0.1.77",
    "@nostr-dev-kit/ndk": "^2.14.38",
    "app-info-parser": "^1.1.6",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "dompurify": "^3.2.7",
    "jquery": "^3.7.1",
    "light-bolt11-decoder": "^3.2.0",
    "marked": "^15.0.12",
    "nostr-tools": "2.16.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "ws": "^8.18.3"
  }
}
